JWT_SECRET=your-secret-here
MAILTRAP_USERNAME=your-mailtrap-username
MAILTRAP_PASSWORD=your-mailtrap-password
GRAFANA_ADMIN_PASSWORD=admin
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# --- Only on a server with a public address (the defaults fit http://localhost:5173) ---
# Browser origins allowed to call the API (comma-separated, "*" allowed in patterns):
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,https://*.trycloudflare.com
# Link in the registration email:
# FRONTEND_CONFIRM_URL=https://your-shop.example.com/confirm
# Start the Cloudflare quick tunnel container as well:
# COMPOSE_PROFILES=tunnel
