JWT_SECRET=your-secret-here
GRAFANA_ADMIN_PASSWORD=admin
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# --- Only on a server with a public address (the defaults fit http://localhost:5173) ---
# Browser origins allowed to call the API (comma-separated, "*" allowed in patterns):
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,https://*.trycloudflare.com
# Link in the registration email:
# FRONTEND_CONFIRM_URL=https://your-shop.example.com/confirm
# Start the Cloudflare quick tunnel container as well:
# COMPOSE_PROFILES=tunnel

# --- Only to send real emails (default: Mailpit catches them, inbox on http://localhost:8025) ---
# Example Gmail with an app password (myaccount.google.com/apppasswords):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
