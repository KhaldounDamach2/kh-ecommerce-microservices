                </mxCell>
                <mxCell id="dev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;git push origin main" vertex="1">
                    <mxGeometry height="60" width="170" x="20" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="github" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;repository · main branch" vertex="1">
                    <mxGeometry height="60" width="180" x="250" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="actions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;" value="&lt;b&gt;GitHub Actions · .github/workflows/ci.yml&lt;/b&gt;" vertex="1">
                    <mxGeometry height="250" width="680" x="500" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="backend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;build-backend&lt;/b&gt; (matrix × 6, in parallel)&lt;br&gt;eureka-server · api-gateway · auth-service&lt;br&gt;product-service · order-service · notification-service&lt;br&gt;&lt;i&gt;./mvnw clean verify&lt;/i&gt; (Java 21, unit tests)" vertex="1">
                    <mxGeometry height="90" width="330" x="520" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="frontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;build-frontend&lt;/b&gt;&lt;br&gt;Node 20 · npm ci · vite build" vertex="1">
                    <mxGeometry height="60" width="330" x="520" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="notify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b&gt;notify&lt;/b&gt; (push to main only)&lt;br&gt;runs when both jobs are green&lt;br&gt;uploads deployment-signal artifact&lt;br&gt;with the commit SHA" vertex="1">
                    <mxGeometry height="90" width="250" x="900" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="vm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;verticalAlign=top;" value="&lt;b&gt;Ubuntu VM (VirtualBox, behind NAT)&lt;/b&gt;" vertex="1">
                    <mxGeometry height="250" width="1160" x="20" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="cron" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" value="&lt;b&gt;cron&lt;/b&gt; · every 5 minutes&lt;br&gt;~/ci-deploy.sh" vertex="1">
                    <mxGeometry height="60" width="190" x="40" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="poll" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" value="Query GitHub public API:&lt;br&gt;latest &lt;b&gt;successful&lt;/b&gt; ci.yml run on main&lt;br&gt;+ all check-runs green?" vertex="1">
                    <mxGeometry height="80" width="260" x="280" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" value="green SHA&lt;br&gt;≠ local HEAD?" vertex="1">
                    <mxGeometry height="100" width="150" x="590" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="deploy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;git fetch &amp;amp;&amp;amp; git reset --hard origin/main&lt;br&gt;docker compose down&lt;br&gt;docker compose up -d --build" vertex="1">
